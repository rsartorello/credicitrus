# =============================================================================
# Credicitrus CMS — variáveis por ambiente (Dev / Prod)
# TI: preencher no Azure (App Settings / Variable Group / Key Vault). Nunca versionar .env com valores reais.
# Passo a passo de deploy: docs/ti/Credicitrus-CMS-Orientacao-TI.pdf (seção 7).
# Após preencher no Azure, devolver o bloco de variáveis à equipe de desenvolvimento (seção 6.3 do PDF).
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.credicitrus.com.br

# --- Feature flag ---
# false = site usa conteúdo estático legado (fallback)
CMS_ENABLED=true

# --- SQL Server (instância isolada por ambiente) ---
DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_NAME=CredicitrusCms
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_ENCRYPT=true
DATABASE_TRUST_SERVER_CERTIFICATE=false

# --- Uploads locais (pasta FORA do diretório sobrescrito no deploy) ---
# Exemplos:
#   Windows Prod: D:\dados\credicitrus\prod\uploads
#   Windows Dev:  D:\dados\credicitrus\dev\uploads
#   Linux:        /var/dados/credicitrus/uploads
#   Local:        ../credicitrus-uploads
CMS_UPLOAD_PATH=../credicitrus-uploads

# Prefixo público dos arquivos (Route Handler /media/...)
CMS_MEDIA_PUBLIC_PREFIX=/media

# --- Auth do painel /admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Mínimo 32 caracteres. Gere com: openssl rand -hex 32
ADMIN_AUTH_SECRET=
# Bootstrap via .env é IMPOSSÍVEL em production. Em dev/staging, desligue com:
# ADMIN_ALLOW_ENV_BOOTSTRAP=false

# --- Gate temporário do site (/acesso) ---
# Desligado por padrão. Para reativar staging fechado:
#   SITE_ACCESS_ENABLED=true
#   SITE_ACCESS_PASSWORD=...
#   SITE_ACCESS_SECRET=...  (openssl rand -hex 32)
SITE_ACCESS_ENABLED=false
SITE_ACCESS_PASSWORD=
SITE_ACCESS_SECRET=

# Confiar em X-Forwarded-For / X-Real-IP (obrigatório atrás de proxy em prod).
# Em local sem proxy, deixe false/omitido.
# TRUST_PROXY=true

# --- SEO / indexação ---
# true = indexar; false = forçar noindex.
# Se omitido: indexa só quando o gate estiver desligado.
# SITE_ROBOTS_INDEX=true

# =============================================================================
# RECOMENDADO NA INFRA (responsabilidade TI / servidor — não é código Next)
# =============================================================================
# 1. HTTPS terminado no reverse proxy + redirecionar HTTP→HTTPS
# 2. HSTS também no proxy (app já envia em NODE_ENV=production)
# 3. WAF / rate limit no gateway (Cloudflare, Azure Front Door, IIS ARR, nginx)
#    — o rate limit in-app é por processo Node e não substitui o edge
# 4. Backup e permissões restritas de CMS_UPLOAD_PATH (só a conta do app)
# 5. Antivírus / scan de uploads no host, se política da cooperativa exigir
# 6. Segredos únicos por ambiente; rotacionar ADMIN_AUTH_SECRET no go-live
# 7. Dependabot / npm audit no pipeline Azure DevOps
# 8. MFA no painel (Authenticator) se o /admin for exposto na internet
# 9. Captcha (Turnstile/reCAPTCHA) no login após N falhas, se WAF não cobrir
# 10. Pentest externo periódico após go-live
# =============================================================================
